{
  "name": "agent-panel",
  "displayName": "Agent Panel",
  "description": "An agent chat panel for VS Code and Cursor that runs your local Claude Code and Cursor Agent CLIs in one thread, with per-file Accept / Reject review.",
  "version": "0.7.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:agentPanel.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentPanel",
          "title": "Agent Panel",
          "icon": "$(comment-discussion)"
        }
      ],
      "activitybar": [
        {
          "id": "agentPanelLauncher",
          "title": "Agent Panel",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentPanel": [
        {
          "type": "webview",
          "id": "agentPanel.sidebar",
          "name": "Agent Panel"
        }
      ],
      "explorer": [
        {
          "id": "agentPanel.changes",
          "name": "Review",
          "contextualTitle": "Edited files",
          "when": "agentPanel.hasReview"
        }
      ],
      "agentPanelLauncher": [
        {
          "id": "agentPanel.launcher",
          "name": "Agent Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "agentPanel.open",
        "title": "Agent Panel: Open",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentPanel.newChat",
        "title": "Agent Panel: New Chat"
      },
      {
        "command": "agentPanel.review.nextChange",
        "title": "Agent Panel: Next Change",
        "icon": "$(arrow-down)"
      },
      {
        "command": "agentPanel.review.prevChange",
        "title": "Agent Panel: Previous Change",
        "icon": "$(arrow-up)"
      },
      {
        "command": "agentPanel.review.nextFile",
        "title": "Agent Panel: Next Edited File",
        "icon": "$(arrow-right)"
      },
      {
        "command": "agentPanel.review.prevFile",
        "title": "Agent Panel: Previous Edited File",
        "icon": "$(arrow-left)"
      },
      {
        "command": "agentPanel.review.acceptFile",
        "title": "Agent Panel: Accept File",
        "icon": "$(check)"
      },
      {
        "command": "agentPanel.review.rejectFile",
        "title": "Agent Panel: Reject File",
        "icon": "$(discard)"
      },
      {
        "command": "agentPanel.review.acceptAll",
        "title": "Agent Panel: Accept All"
      },
      {
        "command": "agentPanel.review.rejectAll",
        "title": "Agent Panel: Reject All"
      },
      {
        "command": "agentPanel.review.openDiff",
        "title": "Agent Panel: Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "agentPanel.review.pickFile",
        "title": "Agent Panel: Go to Edited File"
      },
      {
        "command": "agentPanel.review.refresh",
        "title": "Agent Panel: Refresh Review"
      },
      {
        "command": "agentPanel.addSelection",
        "title": "Add Selection to Agent Panel"
      },
      {
        "command": "agentPanel.showLog",
        "title": "Agent Panel: Show Log"
      }
    ],
    "keybindings": [
      {
        "command": "agentPanel.review.nextChange",
        "key": "alt+f5",
        "when": "agentPanel.hasReview && editorTextFocus"
      },
      {
        "command": "agentPanel.review.prevChange",
        "key": "shift+alt+f5",
        "when": "agentPanel.hasReview && editorTextFocus"
      },
      {
        "command": "agentPanel.review.nextFile",
        "key": "alt+f6",
        "when": "agentPanel.hasReview && editorTextFocus"
      },
      {
        "command": "agentPanel.review.prevFile",
        "key": "shift+alt+f6",
        "when": "agentPanel.hasReview && editorTextFocus"
      },
      {
        "command": "agentPanel.review.acceptFile",
        "key": "alt+enter",
        "when": "agentPanel.hasReview && editorTextFocus"
      },
      {
        "command": "agentPanel.review.rejectFile",
        "key": "alt+backspace",
        "when": "agentPanel.hasReview && editorTextFocus"
      },
      {
        "command": "agentPanel.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentPanel.review.prevChange",
          "when": "agentPanel.hasReview",
          "group": "navigation@1"
        },
        {
          "command": "agentPanel.review.nextChange",
          "when": "agentPanel.hasReview",
          "group": "navigation@2"
        },
        {
          "command": "agentPanel.review.openDiff",
          "when": "agentPanel.hasReview",
          "group": "navigation@3"
        },
        {
          "command": "agentPanel.review.acceptFile",
          "when": "agentPanel.hasReview",
          "group": "navigation@4"
        },
        {
          "command": "agentPanel.review.rejectFile",
          "when": "agentPanel.hasReview",
          "group": "navigation@5"
        }
      ],
      "view/title": [
        {
          "command": "agentPanel.review.acceptAll",
          "when": "view == agentPanel.changes",
          "group": "navigation@1"
        },
        {
          "command": "agentPanel.review.rejectAll",
          "when": "view == agentPanel.changes",
          "group": "navigation@2"
        },
        {
          "command": "agentPanel.review.refresh",
          "when": "view == agentPanel.changes",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentPanel.review.acceptFile",
          "when": "view == agentPanel.changes && viewItem == agentPanel.change",
          "group": "inline@1"
        },
        {
          "command": "agentPanel.review.rejectFile",
          "when": "view == agentPanel.changes && viewItem == agentPanel.change",
          "group": "inline@2"
        },
        {
          "command": "agentPanel.review.openDiff",
          "when": "view == agentPanel.changes && viewItem == agentPanel.change",
          "group": "inline@3"
        }
      ],
      "editor/context": [
        {
          "command": "agentPanel.addSelection",
          "when": "editorHasSelection",
          "group": "9_agentPanel@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentPanel.review.nextChange",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.prevChange",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.nextFile",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.prevFile",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.acceptFile",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.rejectFile",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.acceptAll",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.rejectAll",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.openDiff",
          "when": "agentPanel.hasReview"
        },
        {
          "command": "agentPanel.review.refresh",
          "when": "agentPanel.hasReview"
        }
      ]
    },
    "configuration": {
      "title": "Agent Panel",
      "properties": {
        "agentPanel.claudePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Claude Code CLI. Empty: the one bundled with the Claude Code extension, else `claude` on your PATH.",
          "scope": "machine"
        },
        "agentPanel.cursorPath": {
          "type": "string",
          "default": "",
          "description": "Path to Cursor's `agent` CLI. Empty: ~/.local/bin/agent, else `agent` on your PATH.",
          "scope": "machine"
        },
        "agentPanel.openEditsInEditor": {
          "type": "boolean",
          "default": false,
          "description": "Open the first changed file with its highlights when a turn finishes."
        },
        "agentPanel.chatLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "enumDescriptions": [
            "Chats are tabs inside the Agent Panel secondary sidebar, a fixed space of their own like Cursor's chat (default).",
            "Each chat is an editor tab, all in one locked editor group that nothing else opens in."
          ],
          "default": "sidebar",
          "description": "Where chats open."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "agentPanel.launcher",
        "contents": "Agent Panel opens in the secondary sidebar, in a space of its own.\n[Open Agent Panel](command:agentPanel.open)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npm run build && node --test dist-test/*.test.js",
    "package": "node esbuild.mjs --release && npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Agent Panel runs coding agents that edit files and run commands, so it only works in trusted folders."
    },
    "virtualWorkspaces": false
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "chat",
    "claude",
    "claude code",
    "cursor",
    "coding agent",
    "code review",
    "diff"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "media/icon.png"
}
